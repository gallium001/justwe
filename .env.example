# ============================================================================
# JustWe — Environment Variables
# Copy this file to .env (local dev) or configure these in your hosting
# provider's dashboard (e.g. Vercel Project Settings → Environment Variables).
# ============================================================================

# ---------- Database (PostgreSQL) ----------
# Use a managed Postgres provider: Neon (neon.tech), Supabase (supabase.com),
# Railway, or RDS. DATABASE_URL is used by the app at runtime (pooled
# connection recommended for serverless); DIRECT_URL is used by Prisma
# Migrate and must be a *direct* (non-pooled) connection.
DATABASE_URL="postgresql://user:password@host:5432/justwe?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/justwe?sslmode=require"

# ---------- Authentication (NextAuth) ----------
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Your deployed URL. For local dev: http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"

# ---------- Object Storage (S3-compatible) ----------
# Any S3-compatible provider works: AWS S3, Cloudflare R2 (recommended —
# no egress fees), Backblaze B2, DigitalOcean Spaces.
S3_REGION="auto"
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"   # omit entirely for real AWS S3
S3_ACCESS_KEY_ID="your-access-key-id"
S3_SECRET_ACCESS_KEY="your-secret-access-key"
S3_BUCKET="justwe-media"
# Public base URL photos are served from — a public bucket URL or, ideally,
# a CDN domain in front of the bucket (e.g. Cloudflare public bucket URL,
# or a custom domain like media.justwe.app).
PUBLIC_MEDIA_URL="https://media.justwe.app"
# Hostname only (no protocol), used by next/image remotePatterns.
PUBLIC_MEDIA_HOSTNAME="media.justwe.app"

# ---------- Transactional Email ----------
# Resend (resend.com) is used out of the box. Sign up, verify a sending
# domain, and create an API key.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="JustWe <hello@justwe.app>"

# ---------- Optional: Realtime (for live message/notification pushes) ----------
# The MVP polls for new messages/notifications every few seconds, which needs
# no extra configuration. For true push-based realtime, wire up Pusher
# (pusher.com) or Ably and set these — see README "Realtime (optional)".
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""
